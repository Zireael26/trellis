#!/usr/bin/env sh
# Trellis canonical commit-msg — native, no Node required.
#
# Why this exists: the husky variant shells out to ./node_modules/.bin/commitlint and prints
# "skipping" when it is absent. Across the fleet that absence is the common case, not the edge
# case — most registered projects have no commitlint installed, and every non-Node project
# (native .githooks/) never could. The result was a hook that reported success while checking
# nothing. This enforces the same shape commitlint's config-conventional would.
#
# Deliberately narrower than commitlint: it validates the header only. Body/footer rules stay with
# commitlint where it is installed. A check that runs everywhere and catches the common mistake
# beats a thorough check that runs nowhere.

set -e

MSG_FILE="$1"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# First line that is neither blank nor a comment is the header.
HEADER="$(grep -vE '^[[:space:]]*#' "$MSG_FILE" | grep -vE '^[[:space:]]*$' | head -n 1)"

# Nothing to check — git will reject an empty message itself.
[ -n "$HEADER" ] || exit 0

# Machine-generated headers git creates or rewrites; not authored, not our business.
case "$HEADER" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*|"Applying "*) exit 0 ;;
esac

TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|draft|merge'

fail() {
  echo "[commit-msg] $1" >&2
  echo >&2
  echo "  header: $HEADER" >&2
  echo >&2
  echo "  Expected: <type>[(scope)][!]: <description>" >&2
  echo "  Types:    $(echo "$TYPES" | tr '|' ' ')" >&2
  echo >&2
  echo "  e.g.  feat(baseline): track HRV on the log scale" >&2
  echo "        fix!: reject out-of-range nights instead of clamping" >&2
  exit 1
}

echo "$HEADER" | grep -qE "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+" \
  || fail "not a conventional commit."

# commitlint's config-conventional default: header-max-length = 100.
[ "${#HEADER}" -le 100 ] \
  || fail "header is ${#HEADER} chars; the limit is 100."

# subject-empty / subject-full-stop, the two that actually get tripped.
SUBJECT="${HEADER#*: }"
[ -n "$SUBJECT" ] || fail "description is empty."
case "$SUBJECT" in
  *.) fail "description must not end with a period." ;;
esac

exit 0

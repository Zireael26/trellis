#!/usr/bin/env bash
cat
printf '%s\n' '{"findings":[{"severity":"minor","file":"z","line":1,"msg":"pinned-cmd"}]}'
EOF
  chmod +x "$dir/pinned"
  MARKER="$(mktemp "$BATS_TMPDIR/nocli.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"

  PATH_BACKUP="$PATH"
  export PATH="$STUB_DIR:$PATH"
  run env TRELLIS_OMP_REVIEW_CMD="$dir/pinned" bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"
  rm -rf "$dir" "$STUB_DIR" "$MARKER"

  [ "$status" -eq 0 ]
  [[ "$output" == *'"pinned-cmd"'* ]]
  grep -q RAN_OMP "$MARKER" && { echo "CLI route should be shadowed by the pinned cmd"; false; }
  teardown_tombstone
}

@test "omp-reviewer: forwards envelope bytes untouched on stdin" {

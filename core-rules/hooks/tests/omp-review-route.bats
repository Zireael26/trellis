#!/usr/bin/env bash
cat >"$dir/seen"
printf '%s\n' '{"findings":[]}'
EOF
  chmod +x "$dir/capture"
  run env TRELLIS_OMP_REVIEW_CMD="$dir/capture" bash "$LIB" <<<"$ENVELOPE"


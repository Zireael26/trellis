# =========================================================================
# SessionStart writer authority
# =========================================================================

@test "herdr session hook writes only an active-release-bound deciding artifact" {
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  RELEASE_RESOLVER="$(make_active_release_resolver "$FAKE_HOME")"
  POISON_PROJECT="$(mktemp -d "$BATS_TMPDIR/poisonproject.XXXXXX")"
  POISON_RESOLVER="$POISON_PROJECT/.claude/skills/herdr-foreman/scripts/resolve-roles.py"
  mkdir -p "$(dirname "$POISON_RESOLVER")"
  printf 'raise SystemExit(91)\n' >"$POISON_RESOLVER"
  CLI_DIR="$(make_session_resolver_stubs)"
  ROLE_STATE="$FAKE_HOME/.omp/agent/roles-resolved.json"
  POLICY="$FAKE_HOME/.trellis/releases/1.2.3/payload/core-rules/skills/herdr-foreman/roles.json"

  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    HOME="$FAKE_HOME" TRELLIS_HOME="$FAKE_HOME/.trellis" \
    HERDR_ENV=1 HERDR_WORKSPACE_ID=fixture-workspace HERDR_PANE_ID=fixture-pane \
    CLAUDE_PROJECT_DIR="$POISON_PROJECT" PATH="$CLI_DIR:$PATH" \
    bash "$SESSION_HOOK"

  [ "$status" -eq 0 ]
  [ -f "$RELEASE_RESOLVER" ]
  [ -f "$ROLE_STATE" ] || { echo "release resolver was not selected: $output"; false; }
  [[ "$output" == *"DEGRADED: refuter has 2/3 independent seats"* ]] || {
    echo "missing refuter degradation: $output"; false;
  }
  [[ "$output" == *"DEGRADED: no candidate for merge_reviewer"* ]] || {
    echo "missing merge_reviewer degradation: $output"; false;
  }
  [[ "$output" == *"route merge_reviewer, refuter to the Claude apex"* ]] || {
    echo "missing Claude-apex routing: $output"; false;
  }
  python3 - "$ROLE_STATE" "$POLICY" <<'PY'
import hashlib
import json
import sys

state_path, policy_path = sys.argv[1:]
with open(policy_path, "rb") as source:
    policy_bytes = source.read()
with open(state_path, encoding="utf-8") as source:
    artifact = json.load(source)
assert artifact["roles_policy"] == {
    "roles_sha256": hashlib.sha256(policy_bytes).hexdigest(),
    "cache_ttl_seconds": json.loads(policy_bytes)["cache_ttl_seconds"],
}
scope = artifact["resolution_scope"]
assert scope["herdr_workspace_id"] == "fixture-workspace"
assert scope["herdr_pane_id"] == "fixture-pane"
assert scope["implementer"] == "luna"
assert scope["implementer_model"] == "openai-codex/gpt-5.6-luna:max"
assert scope["implementer_provider"] == "openai-codex"
assert scope["verdict_families_distinct"] is False
chosen = artifact["roles"]["implementer"]["chosen"]
assert (
    chosen["agent"],
    chosen["model"],
    chosen["provider"],
) == (
    scope["implementer"],
    scope["implementer_model"],
    scope["implementer_provider"],
)
assert (
    json.loads(policy_bytes)["agents"][chosen["agent"]]["family"]
    == scope["implementer_family"]
)
assert artifact["approval_ready"] is False
assert artifact["family_collapse"] == []
assert artifact["degraded_verdict_roles"] == ["merge_reviewer", "refuter"]
assert artifact["roles"]["merge_reviewer"]["chosen"] is None
assert [seat["agent"] for seat in artifact["roles"]["refuter"]["seats"]] == [
    "glm-flash-go",
    "flash",
]
PY
  rm -rf "$FAKE_HOME" "$POISON_PROJECT" "$CLI_DIR"
}

@test "herdr session hook clears a deciding artifact whose implementer row diverges" {
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  RELEASE_RESOLVER="$(make_active_release_resolver "$FAKE_HOME")"
  POLICY="$FAKE_HOME/.trellis/releases/1.2.3/payload/core-rules/skills/herdr-foreman/roles.json"
  CLI_DIR="$(make_session_resolver_stubs)"
  ROLE_STATE="$FAKE_HOME/.omp/agent/roles-resolved.json"

  # Production-shaped partial artifact: luna in scope, cheap-2 in the live
  # implementer row. Writer validation must reject the binding after schema
  # checks, not fail earlier on fixture-only families or false approval.
  cat >"$RELEASE_RESOLVER" <<'PY'
import datetime as dt
import hashlib
import json
import os
import sys

policy_path = os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "roles.json"
)
with open(policy_path, "rb") as source:
    policy_bytes = source.read()
policy = json.loads(policy_bytes)


def candidate(role, agent):
    if not any(
        item["agent"] == agent
        for item in policy["roles"][role]["chain"]
    ):
        raise ValueError(f"{agent} is not a candidate for {role}")
    return dict(policy["agents"][agent], agent=agent)


def resolved(role, agent):
    configured = candidate(role, agent)
    chosen = {
        key: configured[key] for key in ("agent", "model", "provider")
    }
    chosen.update({"remaining": 1.0, "note": "reported"})
    return {
        "purpose": policy["roles"][role]["purpose"],
        "chosen": chosen,
        "trail": [dict(chosen, eligible=True, reason="eligible")],
        "refusals": [],
        "overflow": None,
    }


def resolved_none(role, refusal_specs):
    refusals = []
    for agent, reason in refusal_specs:
        configured = candidate(role, agent)
        refusals.append({
            "agent": configured["agent"],
            "model": configured["model"],
            "provider": configured["provider"],
            "eligible": False,
            "reason": reason,
            "remaining": None,
        })
    return {
        "purpose": policy["roles"][role]["purpose"],
        "chosen": None,
        "trail": [],
        "refusals": refusals,
        "overflow": None,
    }


def resolved_refuter(agents):
    seats = []
    for agent in agents:
        configured = candidate("refuter", agent)
        seat = {
            key: configured[key] for key in ("agent", "model", "provider")
        }
        seat.update({
            "remaining": 1.0,
            "note": "reported",
            "eligible": True,
            "reason": "eligible",
        })
        seats.append(seat)
    chosen = {
        key: seats[0][key]
        for key in ("agent", "model", "provider", "remaining", "note")
    }
    return {
        "purpose": policy["roles"]["refuter"]["purpose"],
        "chosen": chosen,
        "trail": [dict(seat) for seat in seats],
        "refusals": [],
        "overflow": None,
        "seats": seats,
        "required_seats": 3,
    }


if "--json" in sys.argv[1:]:
    print(json.dumps({
        "roles": {"implementer": {"chosen": {"agent": "luna"}}}
    }))
    raise SystemExit(0)

scope_implementer = candidate("implementer", "luna")
roles = {
    "foreman": resolved("foreman", "sol"),
    "implementer": resolved("implementer", "cheap-2"),
    "hard_implementer": resolved("hard_implementer", "luna"),
    "deep_worker": resolved("deep_worker", "glm-flash-go"),
    "scout": resolved("scout", "flash"),
    "reviewer": resolved("reviewer", "cheap"),
    "security_reviewer": resolved("security_reviewer", "security-reviewer"),
    "merge_reviewer": resolved_none("merge_reviewer", (
        ("sol", "same-family"),
        ("grok", "verdict-family-in-use"),
    )),
    "refuter": resolved_refuter(("glm-flash-go", "flash")),
}
if set(roles) != set(policy["roles"]):
    raise SystemExit("fixture roles do not match policy")
artifact = {
    "resolved_at": dt.datetime.now(dt.timezone.utc).isoformat(
        timespec="seconds"
    ),
    "resolution_nonce": os.environ["HERDR_RESOLUTION_NONCE"],
    "roles_policy": {
        "roles_sha256": hashlib.sha256(policy_bytes).hexdigest(),
        "cache_ttl_seconds": policy["cache_ttl_seconds"],
    },
    "usage_source": "fixture",
    "resolution_scope": {
        "scoped": True,
        "implementer": scope_implementer["agent"],
        "implementer_model": scope_implementer["model"],
        "implementer_provider": scope_implementer["provider"],
        "implementer_family": policy["agents"][scope_implementer["agent"]]["family"],
        "cross_family_enforced": True,
        "verdict_families_distinct": False,
        "herdr_workspace_id": os.environ["HERDR_WORKSPACE_ID"],
        "herdr_pane_id": os.environ["HERDR_PANE_ID"],
    },
    "approval_ready": False,
    "degraded_roles": ["merge_reviewer", "refuter"],
    "degraded_verdict_roles": ["merge_reviewer", "refuter"],
    "family_collapse": [],
    "roles": roles,
}
state = os.path.join(
    os.environ["HOME"], ".omp", "agent", "roles-resolved.json"
)
os.makedirs(os.path.dirname(state), exist_ok=True)
with open(state, "w", encoding="utf-8") as destination:
    json.dump(artifact, destination)
os.chmod(state, 0o600)
PY

  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    HOME="$FAKE_HOME" TRELLIS_HOME="$FAKE_HOME/.trellis" \
    HERDR_ENV=1 HERDR_WORKSPACE_ID=fixture-workspace HERDR_PANE_ID=fixture-pane \
    PATH="$CLI_DIR:$PATH" bash "$SESSION_HOOK"

  [ "$status" -eq 0 ]
  [ ! -e "$ROLE_STATE" ] || {
    echo "scope-divergent deciding artifact was not cleared"
    false
  }
  rm -rf "$FAKE_HOME" "$CLI_DIR"
}


# =========================================================================
# code-review-subagent.sh routing under TRELLIS_OMP=1
# =========================================================================

@test "code-review-subagent under TRELLIS_OMP=1 inside Herdr routes to omp-reviewer, never claude" {
  setup_project_dir
  setup_tombstone
  (
    cd "$PROJECT_DIR" || exit 1
    printf 'def a():\n    return 1\n' >a.py
    printf 'def b():\n    return 2\n' >b.py
    printf 'def c():\n    return 3\n' >c.py
    git add -A
  )

  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  STATE="$(make_deciding_reviewer_state "$FAKE_HOME")"
  HOME_BACKUP="${HOME:-}"
  TRELLIS_HOME_BACKUP="${TRELLIS_HOME:-}"
  export HOME="$FAKE_HOME"
  export TRELLIS_HOME="$FAKE_HOME/.trellis"
  unset CODE_REVIEWER_CMD TRELLIS_OMP_REVIEW_CMD OMP_ROLE_STATE
  export HERDR_ENV=1 HERDR_WORKSPACE_ID=fixture-workspace HERDR_PANE_ID=fixture-pane
  MARKER="$(mktemp "$BATS_TMPDIR/hookran.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"
  PATH_BACKUP="$PATH"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$STUB_DIR:$CLAUDE_DIR:$PATH"
  export TRELLIS_OMP=1
  run_with_stderr "$HOOK" '{"stop_hook_active":false}'
  unset TRELLIS_OMP HERDR_ENV HERDR_WORKSPACE_ID HERDR_PANE_ID
  export PATH="$PATH_BACKUP"
  export HOME="$HOME_BACKUP"
  if [ -n "$TRELLIS_HOME_BACKUP" ]; then
    export TRELLIS_HOME="$TRELLIS_HOME_BACKUP"
  else
    unset TRELLIS_HOME
  fi
  RAN="$(cat "$MARKER" 2>/dev/null || true)"
  rm -rf "$FAKE_HOME" "$STUB_DIR" "$CLAUDE_DIR"
  rm -f "$MARKER"

  # Hook completed (exit 0) and reached the omp route…
  [ "$status" -eq 0 ]
  [[ "$RAN" == *RAN_OMP* ]] || { echo "expected the omp route to run; stderr: $stderr"; false; }
  # …and NO Claude process was ever spawned.
  [ ! -s "$TOMBSTONE" ] || { echo "CLAUSE REACHED:"; cat "$TOMBSTONE"; false; }
  teardown_tombstone
}

@test "code-review-subagent without TRELLIS_OMP keeps the canonical ladder (claude reachable)" {
  setup_project_dir
  setup_tombstone
  (
    cd "$PROJECT_DIR" || exit 1
    printf 'def a():\n    return 1\n' >a.py
    printf 'def b():\n    return 2\n' >b.py
    printf 'def c():\n    return 3\n' >c.py
    git add -A
  )

  # Sentinel forces the canonical ladder's deterministic rung; the point of
  # THIS test is only that the canonical lib (not omp-reviewer) was selected.
  CLAUDE_DIR="$(make_tombstone_claude)"
  PATH_BACKUP="$PATH"
  export PATH="$CLAUDE_DIR:$PATH"
  export TRELLIS_REVIEW_IN_PROGRESS=1
  unset TRELLIS_OMP || true
  run_with_stderr "$HOOK" '{"stop_hook_active":false}'
  unset TRELLIS_REVIEW_IN_PROGRESS
  export PATH="$PATH_BACKUP"

  [ "$status" -eq 0 ]
  # Deterministic rung on a secret-free diff → empty verdict; the hook emits
  # additionalContext only for non-empty advisories, so silence is expected.
  [ -z "$output" ] || [[ "$output" == *'"findings":'* ]] || { echo "GOT:[$output]"; false; }
  # The tombstone stays clean: the sentinel skipped the claude rung.
  [ ! -s "$TOMBSTONE" ] || { echo "CLAUDE REACHED:"; cat "$TOMBSTONE"; false; }
  teardown_tombstone
}

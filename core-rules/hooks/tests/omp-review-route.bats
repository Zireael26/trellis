#!/usr/bin/env bats
# Tests for lib/omp-reviewer.sh + the OMP routing in code-review-subagent.sh /
# propose-rules.sh — the no-Anthropic stop guarantee (hooks.md: "OMP owns its
# stop event. Any model-backed hook reached from that event MUST use the live
# non-Anthropic eval/role-resolver route … or skip the model rung").
#
# The invariant under test: when TRELLIS_OMP=1, NO test path can reach a
# `claude` binary. Every test plants a `claude` stub on PATH that WRITES A
# TOMBSTONE if executed; a pass requires the tombstone to be absent.
#
# PORTABLE / MIRROR-CLEAN: fixtures under mktemp; no absolute machine paths;
# no network; the real `claude` and real `omp` are never invoked.

load helpers

# One-line findings validator (local copy of the ladder suite's helper).
assert_valid_findings() {
  if command -v jq >/dev/null 2>&1; then
    echo "$output" | jq -e 'type == "object" and (.findings | type == "array")' >/dev/null
  else
    [[ "$output" == *'{"findings":'* ]] || { echo "$output"; false; }
  fi
}

LIB="$HOOKS_DIR/lib/omp-reviewer.sh"
HOOK="$HOOKS_DIR/code-review-subagent.sh"
SESSION_HOOK="$HOOKS_DIR/herdr-foreman-session.sh"

REVIEW_INPUT='diff --git a/fixture.txt b/fixture.txt
--- a/fixture.txt
+++ b/fixture.txt
@@ -0,0 +1 @@
+fixture reviewer input'

# --- fixture builders ------------------------------------------------------

# A claude stub that records its own execution into $TOMBSTONE. If this file
# exists after a hook run, a Claude process was reachable — the invariant broke.
make_tombstone_claude() {
  local dir stub
  dir="$(mktemp -d "$BATS_TMPDIR/ompclaude.XXXXXX")"
  stub="$dir/claude"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'printf "CLAUDE_REACHED\\n" >> "%s"\n' "$TOMBSTONE"
    printf 'printf \x27{"findings":[]}\x27\\n'
  } >"$stub"
  chmod +x "$stub"
  printf '%s' "$dir"
}

# An omp stub that behaves like `omp -p` for the reviewer route: reads stdin,
# prints a findings line, records that it ran and the model argv it received.
make_omp_stub() {
  local dir out="$1"
  dir="$(mktemp -d "$BATS_TMPDIR/ompstub.XXXXXX")"
  cat >"$dir/omp" <<EOF
#!/usr/bin/env bash
cat >/dev/null
{
  printf 'RAN_OMP\n'
  printf 'ARGS'
  printf '\t%s' "\$@"
  printf '\n'
} >> "$out"
printf '{"findings":[]}\n'
EOF
  chmod +x "$dir/omp"
  printf '%s' "$dir"
}

make_session_resolver_stubs() {
  local dir
  dir="$(mktemp -d "$BATS_TMPDIR/resolverstubs.XXXXXX")"
  cat >"$dir/omp" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  usage)
    printf '%s\n' '{"reports":[{"provider":"openai-codex","limits":[{"id":"shared","amount":{"remainingFraction":0.9}}]},{"provider":"xai-oauth","limits":[{"id":"shared","amount":{"remainingFraction":0.9}}]},{"provider":"opencode-go","limits":[{"id":"shared","amount":{"remainingFraction":0.9}}]},{"provider":"nous-portal","limits":[{"id":"shared","amount":{"remainingFraction":0.9}}]},{"provider":"meta","limits":[{"id":"shared","amount":{"remainingFraction":0.9}}]},{"provider":"google-antigravity","limits":[{"id":"shared","amount":{"remainingFraction":0.9}}]}],"disabledCredentials":[]}'
    ;;
  token)
    printf 'fixture-token\n'
    ;;
  *)
    exit 64
    ;;
esac
EOF
  cat >"$dir/herdr" <<'EOF'
#!/usr/bin/env bash
if [ "${1:-}" = agent ] && [ "${2:-}" = list ]; then
  printf '{"result":{"agents":[]}}\n'
  exit 0
fi
exit 64
EOF
  chmod +x "$dir/omp" "$dir/herdr"
  printf '%s' "$dir"
}



# Create an active-release roles policy. The reviewer route must ignore every
# project/legacy lookalike and discover exactly this payload through
# TRELLIS_HOME/config.json.
make_active_release_policy() {
  local home="$1" release="1.2.3"
  local policy="$home/.trellis/releases/$release/payload/core-rules/skills/herdr-foreman/roles.json"

  mkdir -p "$(dirname "$policy")"
  cp "$HOOKS_DIR/../skills/herdr-foreman/roles.json" "$policy"
  printf '{"active_cli_release":"%s"}\n' "$release" >"$home/.trellis/config.json"
  chmod 600 "$home/.trellis/config.json"
  printf '%s' "$policy"
}

make_active_release_resolver() {
  local home="$1" policy resolver
  policy="$(make_active_release_policy "$home")"
  resolver="$(dirname "$policy")/scripts/resolve-roles.py"
  mkdir -p "$(dirname "$resolver")"
  cp "$HOOKS_DIR/../skills/herdr-foreman/scripts/resolve-roles.py" "$resolver"
  printf '%s' "$resolver"
}

# A production-catalog deciding artifact generated by the copied resolver with
# deterministic usage/auth stubs. The live six-family roster is a partial:
# merge_reviewer and refuter degrade, approval_ready stays false, and reviewer
# remains independently consumable.
make_deciding_reviewer_state() {
  local home="$1"
  local nonce="${2:-fixture-workspace:fixture-pane:fixture-pass}"
  local workspace="${3:-fixture-workspace}"
  local pane="${4:-fixture-pane}"
  local state="$home/.omp/agent/roles-resolved.json"
  local resolver
  resolver="$(make_active_release_resolver "$home")"

  mkdir -p "$(dirname "$state")"
  python3 - "$resolver" "$home" "$nonce" "$workspace" "$pane" <<'PY'
import contextlib
import importlib.util
import io
import os
import sys

resolver_path, home, nonce, workspace, pane = sys.argv[1:]
os.environ["HOME"] = home
os.environ["TRELLIS_HOME"] = os.path.join(home, ".trellis")
os.environ["HERDR_ENV"] = "1"
os.environ["HERDR_WORKSPACE_ID"] = workspace
os.environ["HERDR_PANE_ID"] = pane
os.environ["HERDR_RESOLUTION_NONCE"] = nonce

usage = {
    "reports": [
        {
            "provider": "openai-codex",
            "limits": [{"id": "shared", "amount": {"remainingFraction": 0.9}}],
        },
        {
            "provider": "xai-oauth",
            "limits": [{"id": "shared", "amount": {"remainingFraction": 0.9}}],
        },
        {
            "provider": "opencode-go",
            "limits": [{"id": "shared", "amount": {"remainingFraction": 0.9}}],
        },
        {
            "provider": "nous-portal",
            "limits": [{"id": "shared", "amount": {"remainingFraction": 0.9}}],
        },
        {
            "provider": "meta",
            "limits": [{"id": "shared", "amount": {"remainingFraction": 0.9}}],
        },
        {
            "provider": "google-antigravity",
            "limits": [{"id": "shared", "amount": {"remainingFraction": 0.9}}],
        },
    ],
    "disabledCredentials": [],
}

spec = importlib.util.spec_from_file_location("rr", resolver_path)
rr = importlib.util.module_from_spec(spec)
spec.loader.exec_module(rr)
rr.load_usage = lambda ttl, fresh, usage_source="omp": (usage, "fixture")
rr.auth_probe_passes = lambda candidate, cache: True
sys.argv = [resolver_path, "--implementer", "luna"]
with contextlib.redirect_stdout(io.StringIO()):
    rr.main()
PY
  chmod 600 "$state"
  printf '%s' "$state"
}

assert_omp_reviewer_fail_closed() {
  local fake_home="$1"
  local workspace="${2:-fixture-workspace}"
  local pane="${3:-fixture-pane}"
  local marker stub_dir path_backup claude_dir
  marker="$(mktemp "$BATS_TMPDIR/failclosed.XXXXXX")"
  stub_dir="$(make_omp_stub "$marker")"
  path_backup="$PATH"
  claude_dir="$(make_tombstone_claude)"
  export PATH="$stub_dir:$claude_dir:$PATH"
  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    HOME="$fake_home" TRELLIS_HOME="$fake_home/.trellis" \
    HERDR_ENV=1 HERDR_WORKSPACE_ID="$workspace" HERDR_PANE_ID="$pane" \
    bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$path_backup"
  [ "$status" -eq 0 ]
  [[ "$output" == *'{"findings":[]}'* ]] || { echo "GOT:[$output]"; false; }
  grep -q RAN_OMP "$marker" && { echo "omp should not have run"; false; }
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  rm -rf "$stub_dir" "$claude_dir"
  rm -f "$marker"
}

setup_tombstone() {
  TOMBSTONE="$(mktemp "$BATS_TMPDIR/tomb.XXXXXX")"
  : >"$TOMBSTONE"
}

teardown_tombstone() {
  [ -n "${TOMBSTONE:-}" ] && rm -f "$TOMBSTONE"
}

# =========================================================================
# lib/omp-reviewer.sh unit behavior
# =========================================================================

@test "omp-reviewer: execs CODE_REVIEWER_CMD with untouched stdin" {
  setup_tombstone
  OP_MARKER="$(mktemp "$BATS_TMPDIR/opmark.XXXXXX")"
  dir="$(mktemp -d "$BATS_TMPDIR/oprev.XXXXXX")"
  cat >"$dir/myreviewer" <<EOF
#!/usr/bin/env bash
cat
printf '%s\n' '{"findings":[{"severity":"important","file":"a","line":1,"msg":"from-operator"}]}'
printf "OPERATOR_RAN\n" >>"$OP_MARKER"
EOF
  chmod +x "$dir/myreviewer"

  PATH_BACKUP="$PATH"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$CLAUDE_DIR:$PATH"
  run env CODE_REVIEWER_CMD="$dir/myreviewer" bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"
  rm -rf "$dir" "$CLAUDE_DIR"

  [ "$status" -eq 0 ]
  [[ "$output" == *'"from-operator"'* ]]
  grep -q OPERATOR_RAN "$OP_MARKER"
  rm -f "$OP_MARKER"
  # And no Claude process was reached: the tombstone records claude runs only.
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  teardown_tombstone
}

@test "omp-reviewer: missing deciding artifact fails closed without invoking omp" {
  setup_tombstone
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  MARKER="$(mktemp "$BATS_TMPDIR/ompran.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"

  PATH_BACKUP="$PATH"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$STUB_DIR:$CLAUDE_DIR:$PATH"
  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    -u HERDR_ENV -u HERDR_WORKSPACE_ID -u HERDR_PANE_ID \
    HOME="$FAKE_HOME" bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"

  [ "$status" -eq 0 ]
  [[ "$output" == *'{"findings":[]}'* ]] || { echo "GOT:[$output]"; false; }
  grep -q RAN_OMP "$MARKER" && { echo "omp should not have run"; false; }
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  rm -rf "$FAKE_HOME" "$STUB_DIR" "$CLAUDE_DIR"
  rm -f "$MARKER"
  teardown_tombstone
}

@test "omp-reviewer: healthy current Herdr artifact uses its resolved model" {
  setup_tombstone
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  MODEL="meta/muse-spark-1.2-contributor:xhigh"
  STATE="$(make_deciding_reviewer_state "$FAKE_HOME")"
  python3 - "$STATE" <<'PY'
import json
import sys

artifact = json.load(open(sys.argv[1], encoding="utf-8"))
assert artifact["approval_ready"] is False
assert artifact["resolution_scope"]["verdict_families_distinct"] is False
assert artifact["degraded_verdict_roles"] == ["merge_reviewer", "refuter"]
assert artifact["roles"]["reviewer"]["chosen"]["agent"] == "cheap"
assert artifact["roles"]["reviewer"]["chosen"]["model"] == "meta/muse-spark-1.2-contributor:xhigh"
assert artifact["roles"]["merge_reviewer"]["chosen"] is None
assert len(artifact["roles"]["refuter"]["seats"]) == 2
print("partial-ok")
PY
  [ ! -e "$FAKE_HOME/.omp/agent/agents/cheap.md" ]
  MARKER="$(mktemp "$BATS_TMPDIR/ompran.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"

  PATH_BACKUP="$PATH"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$STUB_DIR:$CLAUDE_DIR:$PATH"
  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    HOME="$FAKE_HOME" TRELLIS_HOME="$FAKE_HOME/.trellis" \
    HERDR_ENV=1 HERDR_WORKSPACE_ID=fixture-workspace HERDR_PANE_ID=fixture-pane \
    bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"

  [ "$status" -eq 0 ]
  assert_valid_findings
  grep -q RAN_OMP "$MARKER"
  grep -qF "$MODEL" "$MARKER"
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  rm -rf "$FAKE_HOME" "$STUB_DIR" "$CLAUDE_DIR"
  rm -f "$MARKER"
  teardown_tombstone
}

@test "omp-reviewer: rejects an implementer row that diverges from its deciding scope" {
  setup_tombstone
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  STATE="$(make_deciding_reviewer_state "$FAKE_HOME")"
  POLICY="$FAKE_HOME/.trellis/releases/1.2.3/payload/core-rules/skills/herdr-foreman/roles.json"
  python3 - "$STATE" "$POLICY" <<'PY'
import json
import sys

state_path, policy_path = sys.argv[1:]
with open(policy_path, encoding="utf-8") as source:
    policy = json.load(source)
with open(state_path, encoding="utf-8") as source:
    artifact = json.load(source)
deepseek = policy["agents"]["cheap-2"]
assert any(
    isinstance(candidate, dict) and candidate.get("agent") == "cheap-2"
    for candidate in policy["roles"]["implementer"]["chain"]
)
resolved = artifact["roles"]["implementer"]
for candidate in (resolved["chosen"], *resolved["trail"]):
    candidate.update({
        "agent": "cheap-2",
        "model": deepseek["model"],
        "provider": deepseek["provider"],
    })
with open(state_path, "w", encoding="utf-8") as destination:
    json.dump(artifact, destination)
PY
  chmod 600 "$STATE"
  MARKER="$(mktemp "$BATS_TMPDIR/scopeimpl.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"

  PATH_BACKUP="$PATH"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$STUB_DIR:$CLAUDE_DIR:$PATH"
  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    HOME="$FAKE_HOME" TRELLIS_HOME="$FAKE_HOME/.trellis" \
    HERDR_ENV=1 HERDR_WORKSPACE_ID=fixture-workspace HERDR_PANE_ID=fixture-pane \
    bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"

  [ "$status" -eq 0 ]
  [[ "$output" == *'{"findings":[]}'* ]] || { echo "GOT:[$output]"; false; }
  grep -q RAN_OMP "$MARKER" && { echo "omp should not have run"; false; }
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  rm -rf "$FAKE_HOME" "$STUB_DIR" "$CLAUDE_DIR"
  rm -f "$MARKER"
  teardown_tombstone
}

@test "omp-reviewer: never consumes a deciding artifact outside Herdr" {
  setup_tombstone
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  STATE="$(make_deciding_reviewer_state "$FAKE_HOME")"
  MARKER="$(mktemp "$BATS_TMPDIR/nonherdr.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"

  PATH_BACKUP="$PATH"
  HOME_BACKUP="${HOME:-}"
  TRELLIS_HOME_BACKUP="${TRELLIS_HOME:-}"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$STUB_DIR:$CLAUDE_DIR:$PATH"
  export HOME="$FAKE_HOME"
  export TRELLIS_HOME="$FAKE_HOME/.trellis"
  unset CODE_REVIEWER_CMD TRELLIS_OMP_REVIEW_CMD OMP_ROLE_STATE
  unset HERDR_ENV HERDR_WORKSPACE_ID HERDR_PANE_ID
  unset TRELLIS_ROOT CLAUDE_PROJECT_DIR CODEX_PROJECT_DIR
  run_with_stderr "$LIB" "$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"
  if [ -n "$HOME_BACKUP" ]; then export HOME="$HOME_BACKUP"; else unset HOME; fi
  if [ -n "$TRELLIS_HOME_BACKUP" ]; then
    export TRELLIS_HOME="$TRELLIS_HOME_BACKUP"
  else
    unset TRELLIS_HOME
  fi

  [ "$status" -eq 0 ]
  [[ "$output" == *'{"findings":[]}'* ]] || { echo "GOT:[$output]"; false; }
  [[ "$stderr" == *"deciding artifact is unavailable or invalid; deterministic OMP fallback applies"* ]] || {
    echo "stderr:[$stderr]"; false;
  }
  grep -q RAN_OMP "$MARKER" && { echo "omp should not have run"; false; }
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  rm -rf "$FAKE_HOME" "$STUB_DIR" "$CLAUDE_DIR"
  rm -f "$MARKER"
  teardown_tombstone
}

@test "omp-reviewer: refuses a policy-consistent resolved Anthropic model" {
  setup_tombstone
  FAKE_HOME="$(mktemp -d "$BATS_TMPDIR/fakehome.XXXXXX")"
  STATE="$(make_deciding_reviewer_state "$FAKE_HOME")"
  POLICY="$FAKE_HOME/.trellis/releases/1.2.3/payload/core-rules/skills/herdr-foreman/roles.json"
  python3 - "$STATE" "$POLICY" <<'PY'
import hashlib
import json
import sys

state_path, policy_path = sys.argv[1:]
with open(policy_path, encoding="utf-8") as source:
    policy = json.load(source)
with open(state_path, encoding="utf-8") as source:
    artifact = json.load(source)
reviewer_agent = artifact["roles"]["reviewer"]["chosen"]["agent"]
policy["agents"][reviewer_agent].update({
    "model": "google-antigravity/claude-opus-9:xhigh",
    "effort": "xhigh",
})
with open(policy_path, "w", encoding="utf-8") as destination:
    json.dump(policy, destination)
with open(policy_path, "rb") as source:
    policy_bytes = source.read()
for candidate in (
    artifact["roles"]["reviewer"]["chosen"],
    *artifact["roles"]["reviewer"]["trail"],
):
    if candidate.get("agent") == reviewer_agent:
        candidate["model"] = "google-antigravity/claude-opus-9:xhigh"
artifact["roles_policy"] = {
    "roles_sha256": hashlib.sha256(policy_bytes).hexdigest(),
    "cache_ttl_seconds": policy["cache_ttl_seconds"],
}
with open(state_path, "w", encoding="utf-8") as destination:
    json.dump(artifact, destination)
PY
  chmod 600 "$STATE"
  MARKER="$(mktemp "$BATS_TMPDIR/nolan.XXXXXX")"
  STUB_DIR="$(make_omp_stub "$MARKER")"

  PATH_BACKUP="$PATH"
  CLAUDE_DIR="$(make_tombstone_claude)"
  export PATH="$STUB_DIR:$CLAUDE_DIR:$PATH"
  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD -u OMP_ROLE_STATE \
    HOME="$FAKE_HOME" TRELLIS_HOME="$FAKE_HOME/.trellis" \
    HERDR_ENV=1 HERDR_WORKSPACE_ID=fixture-workspace HERDR_PANE_ID=fixture-pane \
    bash "$LIB" <<<"$REVIEW_INPUT"
  export PATH="$PATH_BACKUP"

  [ "$status" -eq 0 ]
  [[ "$output" == *'{"findings":[]}'* ]] || { echo "GOT:[$output]"; false; }
  grep -q RAN_OMP "$MARKER" && { echo "omp should not have run"; false; }
  [ ! -s "$TOMBSTONE" ] || { cat "$TOMBSTONE"; false; }
  rm -rf "$FAKE_HOME" "$STUB_DIR" "$CLAUDE_DIR"
  rm -f "$MARKER"
  teardown_tombstone
}


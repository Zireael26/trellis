@test "omp-reviewer: no route at all → empty findings + rc 0 (caller degrades)" {
  PATH_BACKUP="$PATH"
  # Strip every dir that could carry omp/claude/CODE_REVIEWER_CMD targets.
  CLEAN_PATH="$(mktemp -d "$BATS_TMPDIR/cleanpath.XXXXXX")"
  for cmd in bash sh cat printf sed head tr grep mktemp env command; do
    src="$(command -v "$cmd" 2>/dev/null)" && ln -sf "$src" "$CLEAN_PATH/$cmd"
  done
  run env -u CODE_REVIEWER_CMD -u TRELLIS_OMP_REVIEW_CMD PATH="$CLEAN_PATH" HOME="/nonexistent" bash "$LIB" <<<"$REVIEW_INPUT"
  rm -rf "$CLEAN_PATH"

  [ "$status" -eq 0 ]
  [[ "$output" == *'{"findings":[]}'* ]] || { echo "GOT:[$output]"; false; }
}


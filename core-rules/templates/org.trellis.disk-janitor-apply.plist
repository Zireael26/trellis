<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Trellis disk-janitor APPLY LaunchAgent template (destructive, opt-in).
  scripts/install-disk-janitor-launchd.sh renders canonical paths at install
  time. The agent starts with an empty environment, sets only canonical home,
  TRELLIS_HOME, and a fixed system PATH, then invokes fixed .local/bin/trellis.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.trellis.disk-janitor-apply</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>-i</string>
    <string>HOME=__USER_HOME__</string>
    <string>TRELLIS_HOME=__TRELLIS_HOME__</string>
    <string>PATH=/usr/bin:/bin:/usr/sbin:/sbin</string>
    <string>/bin/bash</string>
    <string>--noprofile</string>
    <string>--norc</string>
    <string>__USER_HOME__/.local/bin/trellis</string>
    <string>disk-janitor</string>
    <string>--apply</string>
    <string>--scopes</string>
    <string>worktrees</string>
    <string>--yes</string>
    <string>--safe-only</string>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/org.trellis.disk-janitor-apply.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/org.trellis.disk-janitor-apply.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>

{
  "permissions": {
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -fr $HOME*)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../*)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard HEAD)",
      "Bash(git reset --hard HEAD~*)",
      "Bash(git reset --hard origin/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Skill|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "PreToolUse"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "UserPromptExpansion"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "UserPromptSubmit"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "PostToolUse"
            ],
            "timeout": 130,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i HOME=__TRELLIS_USER_HOME__ TRELLIS_HOME=__TRELLIS_HOME__ PATH=/usr/bin:/bin:/usr/sbin:/sbin /bin/bash --noprofile --norc __TRELLIS_LAUNCHER__ hook session-start claude \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30,
            "statusMessage": "Loading session context..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "PreCompact"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "Stop"
            ],
            "timeout": 310,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "codex",
              "PreToolUse"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "codex",
              "UserPromptSubmit"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "codex",
              "PostToolUse"
            ],
            "timeout": 130
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env -i HOME=__TRELLIS_USER_HOME__ TRELLIS_HOME=__TRELLIS_HOME__ PATH=/usr/bin:/bin:/usr/sbin:/sbin /bin/bash --noprofile --norc __TRELLIS_LAUNCHER__ hook session-start codex \"${CODEX_PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-$PWD}}\"",
            "timeout": 30,
            "statusMessage": "Loading session context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "codex",
              "Stop"
            ],
            "timeout": 310
          }
        ]
      }
    ]
  }
}

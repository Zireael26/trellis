# Canonical OMP Configuration Baseline (Trellis)
# Scan/classification: Gemini 3.7 Flash
# Hard/advisor/plan: GPT-5.6 Sol xhigh
providers: 
  webSearchOrder: 
    - google
    - gemini
    - codex
  webSearchExclude: 
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - duckduckgo
    - ecosia
    - mojeek
    - public
retry: 
  modelFallback: false
  usageAwareFallback: false
setupVersion: 1
modelRoles: 
  advisor: openai-codex/gpt-5.6-sol:xhigh
  designer: openai-codex/gpt-5.6-terra:max
  smol: openai-codex/gpt-5.6-luna:max
  plan: openai-codex/gpt-5.6-sol:xhigh
  vision: openai-codex/gpt-5.6-terra:xhigh
  commit: openai-codex/gpt-5.6-terra:high
  tiny: openai-codex/gpt-5.6-luna:max
  slow: openai-codex/gpt-5.6-sol:xhigh
  default: openai-codex/gpt-5.6-sol:xhigh
task: 
  agentModelOverrides: 
    cheap: meta/muse-spark-1.2-contributor:xhigh
    luna: openai-codex/gpt-5.6-luna:max
    flash: google-antigravity/gemini-3.7-flash:high
    deepseek: opencode-go/deepseek-v4-flash:max
    glm-flash-go: opencode-go/glm-5.3-flash:max
    glm-flash: nous-portal/z-ai/glm-5.3-flash:max
    sol: openai-codex/gpt-5.6-sol:xhigh
    grok: xai-oauth/grok-4.6:xhigh
    security-reviewer: xai-oauth/grok-4.6:xhigh
  showResolvedModelBadge: true
  enableEffort: true
dev: 
  autoqaConsent: granted
defaultThinkingLevel: auto

# Canonical OMP Configuration Baseline (Trellis)
# Fast execution: Gemini 3.6 Flash (default)
# High-depth reasoning: GPT-5.6 Sol/Terra (advisor, plan, task)
providers: 
  webSearchOrder: 
    - google
    - gemini
    - codex
  webSearchExclude: 
    - perplexity
    - anthropic
    - xai
    - zai
    - exa
    - tinyfish
    - jina
    - kagi
    - tavily
    - firecrawl
    - brave
    - kimi
    - parallel
    - synthetic
    - searxng
    - startpage
    - duckduckgo
    - ecosia
    - mojeek
    - public
retry: 
  modelFallback: false
  fallbackChains: 
    task: 
      - opencode-go/deepseek-v4-flash
setupVersion: 1
modelRoles: 
  advisor: openai-codex/gpt-5.6-sol:xhigh
  designer: openai-codex/gpt-5.6-terra:max
  smol: openai-codex/gpt-5.6-luna:max
  task: openai-codex/gpt-5.6-terra:max
  plan: openai-codex/gpt-5.6-sol:xhigh
  vision: openai-codex/gpt-5.6-terra:xhigh
  commit: openai-codex/gpt-5.6-terra:high
  tiny: openai-codex/gpt-5.6-luna:max
  slow: openai-codex/gpt-5.6-sol:xhigh
  default: openai-codex/gpt-5.6-sol:high
  CHEAP: meta/muse-spark-1.2-contributor:xhigh
task: 
  agentModelOverrides: 
    code-architect: openai-codex/gpt-5.6-sol
    code-explorer: openai-codex/gpt-5.6-luna
    code-reviewer: openai-codex/gpt-5.6-sol
dev: 
  autoqaConsent: granted
defaultThinkingLevel: auto

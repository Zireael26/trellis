{
  "workflowSizeGuideline": "large",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "WorktreeCreate"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__TRELLIS_LAUNCHER__",
            "args": [
              "hook",
              "event",
              "claude",
              "WorktreeRemove"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}

{
  "$schema": "./scripts/lib/trellis.config.schema.json",
  "schema_version": 2,
  "comment": "Example portable Trellis policy. Run `trellis configure` for machine-local setup; do not add machine paths here. Never commit secrets here. Pinning trellis_version is optional but recommended for downstream consumers — it tells scripts/upgrade.sh which canonical version this clone is anchored to. harnesses accepts any combination of 'claude', 'codex', and 'omp'.",

  "maintainer_name": "Your Name",
  "github_user": "your-github-handle",

  "harnesses": ["claude", "codex", "omp"],

  "autonomy_default": 3,
  "comment_autonomy_default": "Optional. Fleet autonomy level 1–5; default 3 (current Trellis behavior). 1=pedagogical, 2=cautious, 3=standard, 4=initiative, 5=autonomous. Per-project override via <project>/.trellis.json autonomy field. Presets may clamp via autonomy_ceiling.",

  "trellis_version": "0.1.0",

  "template": {
    "remote": "git@github.com:your-org/trellis.git",
    "branch": "main"
  },

  "sed_flavor": "auto",

  "approved_mcps": [
    { "name": "operator-scheduler", "purpose": "Private recurring operator jobs", "scope": "fleet" },
    { "name": "computer-use", "purpose": "Native-app screenshots + UI control for ui-verify fallback", "scope": "fleet" },
    { "name": "claude-in-chrome", "purpose": "Browser navigation + DOM-aware actions", "scope": "fleet" }
  ],

  "comment_disk_janitor": "Optional. Tuning for `trellis disk-janitor`. The whole object is optional and every key inside it is optional — omit any key (or the whole block) to take the default shown below. The janitor never auto-deletes; the launchd agent runs `--report` only.",
  "disk_janitor": {
    "enabled": true,
    "cache_ttl_days": 14,
    "worktree_stale_days": 30,
    "free_space_floor_gb": 30,
    "cache_ceiling_gb": 20,
    "skip_projects": []
  },

  "comment_mandatory_pipeline": "Optional (spec 006; core-rules/hooks.md). When enabled, a branch whose net gated diff over spec_required_diff_lines cannot be pushed without ONE of: a spec triad added on this branch (+ interview artifact), a size-capped `/surgical` declaration (<= surgical_max_diff_lines), or a logged `/surgical --emergency` override. Enforced deterministically at pre-push (equal on Claude + Codex by construction) with a Stop-hook early-warning. Default OFF: absence or enabled:false is byte-identical to prior behavior; a present-but-malformed block fails CLOSED. Leave enabled:false until your team is ready to require specs for feature-sized changes.",
  "mandatory_pipeline": {
    "enabled": false,
    "spec_required_diff_lines": 80,
    "surgical_max_diff_lines": 400
  },

  "comment_aeo_gate": "Optional (spec 033). Warn-only AEO diff adapter for mapped public websites. Default OFF. When enabled, all five string fields are required; baseline is repository-relative. The adapter writes evidence below .git/trellis-aeo and never blocks during initial rollout.",
  "aeo_gate": {
    "enabled": false,
    "project": "registry-name",
    "url": "https://example.com",
    "marker_file": "path/to/source-file",
    "marker": "stable deployed marker",
    "baseline": "audits/aeo-baseline/accepted/baseline.json"
  }
}

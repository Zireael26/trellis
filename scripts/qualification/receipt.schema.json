    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "trellis-qualification-receipt/1"
        },
        "candidate_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "t71_source_commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "manifest_generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "claims": {
          "type": "object",
          "properties": {
            "commands": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "oracles": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED",
                  "UNSUPPORTED"
                ]
              }
            },
            "verdict": {
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED",
                "UNSUPPORTED"
              ]
            },
            "cases": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "n_a_reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "key",
                      "n_a_reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "minLength": 1
                      },
                      "n": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "p50": {
                        "type": "number",
                        "minimum": 0
                      },
                      "p90": {
                        "type": "number",
                        "minimum": 0
                      },
                      "before_p50": {
                        "type": "number",
                        "minimum": 0
                      },
                      "before_p90": {
                        "type": "number",
                        "minimum": 0
                      },
                      "before_runs": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      },
                      "verdict": {
                        "enum": [
                          "PASS",
                          "FAIL",
                          "BLOCKED",
                          "UNSUPPORTED"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "n",
                      "p50",
                      "p90",
                      "before_p50",
                      "before_p90",
                      "before_runs",
                      "verdict"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 0
            }
          },
          "required": [
            "commands",
            "oracles",
            "verdict",
            "cases"
          ],
          "additionalProperties": false
        },
        "cell": {
          "const": "artifacts"
        },
        "task": {
          "enum": [
            "T71",
            "T72"
          ]
        },
        "build_hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "platform": {
                "type": "object",
                "properties": {
                  "os": {
                    "enum": [
                      "Darwin",
                      "Linux"
                    ]
                  },
                  "arch": {
                    "enum": [
                      "aarch64",
                      "x86_64"
                    ]
                  },
                  "os_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "filesystem": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ctime_capability": {
                    "enum": [
                      "fine",
                      "coarse",
                      "unknown"
                    ]
                  },
                  "ctime_probe": {
                    "type": "object",
                    "properties": {
                      "capability": {
                        "enum": [
                          "fine",
                          "coarse",
                          "unknown"
                        ]
                      },
                      "same_device": {
                        "type": "boolean"
                      },
                      "samples_ns": {
                        "type": "array",

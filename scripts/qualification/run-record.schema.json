{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trellis://qualification/run-record/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "trellis-qualification-run/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "requirement_id": {
      "type": "string",
      "minLength": 1
    },
    "requirements_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirements_snapshot": {"type": "string", "pattern": "^policy-[0-9a-f]{64}\\.json$"},
    "recorder_sha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "recorder_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "harness_inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "mode": {"enum": ["100644", "100755", "120000"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["path", "mode", "sha256"], "additionalProperties": false
      }
    },
    "measurement": {
      "type": "object",
      "properties": {
        "scratch_base": {"const": "recorder-owned-TMPDIR"},
        "runtime_device": {"type": "integer", "minimum": 0},
        "scratch_device": {"type": "integer", "minimum": 0},
        "same_device": {"type": "boolean"}
      },
      "required": ["scratch_base", "runtime_device", "scratch_device", "same_device"],
      "additionalProperties": false
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "runtime_input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "source",
            "installed"
          ]
        },
        "scope": {
          "enum": [
            "runtime",
            "native-build"
          ]
        },
        "clean": {
          "type": "boolean"
        },
        "stable": {
          "type": "boolean"
        },
        "generation": {
          "type": [
            "string",
            "null"
          ]
        },
        "committed_input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "end_input_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "installed_manifest_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755",
                  "120000",
                  "missing"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "mode",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "scope",
        "clean",
        "stable",
        "generation",
        "committed_input_digest",
        "end_input_digest",
        "installed_manifest_sha256",
        "inputs"
      ],
      "additionalProperties": false
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "cwd_base": {
      "const": "runtime"
    },
    "phase": {
      "enum": [
        "oracle",
        "build",
        "before",
        "after"
      ]
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "host_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "enum": [
            "Darwin",
            "Linux"
          ]
        },
        "arch": {
          "enum": [
            "aarch64",
            "x86_64"
          ]
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "ctime_capability": {
          "enum": [
            "fine",
            "coarse",
            "unknown"
          ]
        },
        "ctime_probe": {
          "type": "object",
          "properties": {
            "capability": {
              "enum": [
                "fine",
                "coarse",
                "unknown"
              ]
            },
            "same_device": {
              "type": "boolean"
            },
            "samples_ns": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 0
            }
          },
          "required": [
            "capability",
            "same_device",
            "samples_ns"
          ],
          "additionalProperties": false
        },
        "emulated": {
          "type": "boolean"
        }
      },
      "required": [
        "os",
        "arch",
        "os_version",
        "filesystem",
        "ctime_capability",
        "ctime_probe",
        "emulated"
      ],
      "additionalProperties": false
    },
    "load": {
      "enum": [
        "normal",
        "contended"
      ]
    },
    "load_facts": {
      "type": "object",
      "properties": {
        "start": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3
        },
        "end": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3
        },
        "logical_cores": {
          "type": "integer",
          "minimum": 1
        },
        "battery_running": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "end",
        "logical_cores",
        "battery_running"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "exit": {
      "type": "integer"
    },
    "exec_error": {
      "type": "boolean"
    },
    "timeout": {
      "type": "boolean"
    },
    "acquisition_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "logs": {
      "type": "object",
      "properties": {
        "stdout": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "stderr": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "stdout",
        "stderr"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "manifest_generation": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "type": "string",
              "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "toolchain": {
              "type": "object",
              "properties": {
                "channel": {
                  "type": "string",
                  "minLength": 1
                },
                "rustc": {
                  "type": "string",
                  "minLength": 1
                },
                "cargo": {
                  "type": "string",
                  "minLength": 1
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "codesign": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cargo_lock_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "rust_toolchain_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "channel",
                "rustc",
                "cargo",
                "targets",
                "codesign",
                "cargo_lock_sha256",
                "rust_toolchain_sha256"
              ],
              "additionalProperties": false
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "enum": [
                      "aarch64-apple-darwin",
                      "x86_64-apple-darwin",
                      "x86_64-unknown-linux-musl",
                      "aarch64-unknown-linux-musl"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "format": {
                    "enum": [
                      "mach-o",
                      "elf-static"
                    ]
                  },
                  "signature": {
                    "enum": [
                      "adhoc",
                      "none"
                    ]
                  },
                  "minimum_os": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "target",
                  "path",
                  "size",
                  "sha256",
                  "format",
                  "signature",
                  "minimum_os"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "enum": [
                      "aarch64-apple-darwin",
                      "x86_64-apple-darwin",
                      "x86_64-unknown-linux-musl",
                      "aarch64-unknown-linux-musl"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "target",
                  "path",
                  "size",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "manifest_generation",
            "version",
            "source_commit",
            "toolchain",
            "inputs",
            "entries",
            "outputs"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "run_id",
    "requirement_id",
    "requirements_sha256",
    "requirements_snapshot",
    "recorder_sha",
    "recorder_input_digest",
    "harness_inputs",
    "measurement",
    "candidate_sha",
    "runtime_input_digest",
    "runtime",
    "argv",
    "cwd",
    "cwd_base",
    "phase",
    "variant",
    "host_id",
    "platform",
    "load",
    "load_facts",
    "started_at",
    "ended_at",
    "duration_ms",
    "exit",
    "exec_error",
    "timeout",
    "acquisition_error",
    "logs",
    "artifacts"
  ],
  "additionalProperties": false
}

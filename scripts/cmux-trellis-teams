#!/usr/bin/env bash
set -euo pipefail

ANTHROPIC_URL="${ANTHROPIC_DIRECT_BASE_URL:-https://api.anthropic.com}"

usage() {
  cat <<'EOF'
Usage: cmux-trellis-teams [options] [--] [claude arguments...]

Start Claude Code through cmux without giving up panes, teams, hooks, or normal
Claude arguments. Sessions are direct to Anthropic; no local gateway is used.

  --mode claude|CODE    Provider topology (default: claude). Any other value
                        is rejected — routed topologies are no longer shipped.
  --model opus|sonnet|haiku|fable|MODEL
                        Main model override (Claude aliases or literal
                        claude-* model IDs)
  --advisor auto|opus|fable|none
                        Advisor override (default: auto)
  --delegates auto|claude|none
                        Allowed Agent providers (default: auto)
  --dry-run             Print the resolved launch contract as JSON
  -h, --help            Show this help

Examples:
  cmux-trellis-teams --dangerously-skip-permissions
  cmux-trellis-teams --mode claude --advisor opus --delegates claude
EOF
}

die() {
  printf 'cmux-trellis-teams: %s\n' "$*" >&2
  exit 2
}

append_prompt_text() {
  local text="$1"
  if [[ -n "$append_prompt" ]]; then
    append_prompt="$append_prompt $text"
  else
    append_prompt="$text"
  fi
}

resolve_cmux() {
  if [[ -n "${CMUX_BIN:-}" ]]; then
    [[ -x "$CMUX_BIN" ]] || die "CMUX_BIN is not executable: $CMUX_BIN"
    printf '%s\n' "$CMUX_BIN"
    return
  fi
  if command -v cmux >/dev/null 2>&1; then
    command -v cmux
    return
  fi
  if [[ -x /Applications/cmux.app/Contents/Resources/bin/cmux ]]; then
    printf '%s\n' /Applications/cmux.app/Contents/Resources/bin/cmux
    return
  fi
  die "cmux was not found; install cmux or set CMUX_BIN"
}

mode=claude
requested_model=
requested_advisor=
requested_delegates=
dry_run=false
forwarded=()

while (($#)); do
  case "$1" in
    --mode)
      (($# >= 2)) || die "--mode requires a value"
      mode=$2
      shift 2
      ;;
    --mode=*)
      mode=${1#*=}
      shift
      ;;
    --model)
      (($# >= 2)) || die "--model requires a value"
      requested_model=$2
      shift 2
      ;;
    --model=*)
      requested_model=${1#*=}
      shift
      ;;
    --advisor)
      (($# >= 2)) || die "--advisor requires a value"
      requested_advisor=$2
      shift 2
      ;;
    --advisor=*)
      requested_advisor=${1#*=}
      shift
      ;;
    --delegates)
      (($# >= 2)) || die "--delegates requires a value"
      requested_delegates=$2
      shift 2
      ;;
    --delegates=*)
      requested_delegates=${1#*=}
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      forwarded+=("$@")
      break
      ;;
    *)
      forwarded+=("$1")
      shift
      ;;
  esac
done

[[ "$mode" == claude ]] || die "unsupported mode '$mode' — only --mode claude is available"

command -v jq >/dev/null 2>&1 || die "missing dependency: jq"

# --- resolution (direct Claude topology only) ------------------------------
claude_model="opus[1m]"
topology=direct
base_url=$ANTHROPIC_URL
case "$requested_model" in
  "") ;;
  opus|opus[1m]) claude_model="opus[1m]" ;;
  sonnet) claude_model=claude-sonnet-5 ;;
  haiku) claude_model=claude-haiku-4-5-20251001 ;;
  fable) claude_model=claude-fable-5 ;;
  *)
    if [[ "$requested_model" == claude-* ]]; then
      claude_model=$requested_model
    else
      die "unsupported model '$requested_model' — use a Claude alias (opus|sonnet|haiku|fable) or a literal claude-* model ID"
    fi
    ;;
esac

advisor="${requested_advisor:-auto}"
case "$advisor" in
  auto|opus|fable|none) ;;
  *) die "unsupported advisor '$advisor' — use auto|opus|fable|none" ;;
esac

delegates="${requested_delegates:-auto}"
case "$delegates" in
  auto|claude|none) ;;
  *) die "unsupported delegates '$delegates' — use auto|claude|none" ;;
esac

append_prompt=
env_json="$(
  jq -cn \
    --arg base "$base_url" \
    '{
      ANTHROPIC_BASE_URL: $base,
      ANTHROPIC_DEFAULT_OPUS_MODEL: "claude-opus-5",
      ANTHROPIC_DEFAULT_SONNET_MODEL: "claude-sonnet-5",
      ANTHROPIC_DEFAULT_HAIKU_MODEL: "claude-haiku-4-5-20251001"
    }'
)"

case "$advisor" in
  none)
    advisor_model=claude-opus-5
    env_json="$(jq -c '. + {CLAUDE_CODE_DISABLE_ADVISOR_TOOL:"1"}' <<<"$env_json")"
    ;;
  fable)
    advisor_model=claude-fable-5
    ;;
  auto|opus)
    advisor_model=claude-opus-5
    ;;
esac

append_prompt_text "Trellis Agent policy: --delegates $delegates governs which providers Agent calls may request. Never change model, subagent_type, or name to hide a disallowed provider; report lane failures to the caller without silent substitution."
append_prompt_text 'Trellis Agent lifecycle: the root orchestrator may pass name only when intentionally creating a named teammate mailbox. A named teammate or any nested Agent caller must omit name and use an unnamed direct-result subagent. Agent names are mailbox identities, never TaskOutput job IDs: wait for mailbox completion and use SendMessage for follow-up; never use TaskOutput or TaskList to poll them. Unnamed Agent results return directly to their caller. The root calls TaskStop by name as soon as named work is accepted, superseded, failed, or abandoned; do not originate shutdown_request.'

settings="$(
  jq -cn \
    --arg model "$claude_model" \
    --arg advisorModel "$advisor_model" \
    --argjson env "$env_json" \
    '{ model:$model, advisorModel:$advisorModel, env:$env }'
)"

cmux_bin="$(resolve_cmux)"
command=("$cmux_bin" claude-teams --settings "$settings")
if [[ -n "$append_prompt" ]]; then
  command+=(--append-system-prompt "$append_prompt")
fi
if ((${#forwarded[@]})); then
  command+=("${forwarded[@]}")
fi

if [[ "$dry_run" == true ]]; then
  command_json="$(jq -cn --args '$ARGS.positional' -- "${command[@]}")"
  jq -n \
    --arg mode "$mode" \
    --arg main_model "$claude_model" \
    --arg claude_model "$claude_model" \
    --arg advisor "$advisor" \
    --arg advisor_transport direct \
    --arg delegates "$delegates" \
    --arg topology "$topology" \
    --arg base_url "$base_url" \
    --argjson settings "$settings" \
    --argjson command "$command_json" \
    '{
      mode:$mode,
      main_model:$main_model,
      claude_model:$claude_model,
      advisor:$advisor,
      advisor_transport:$advisor_transport,
      delegates:$delegates,
      topology:$topology,
      base_url:$base_url,
      settings:$settings,
      command:$command
    }'
  exit 0
fi

printf 'Trellis session: mode=%s main=%s advisor=%s delegates=%s\n' \
  "$mode" "$claude_model" "$advisor" "$delegates" >&2

exec "${command[@]}"

#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
CONTEXT_RESOLVER="$ROOT/scripts/gptx/model-context.js"
ROUTER_URL="${GPTX_BASE_URL:-http://127.0.0.1:8318}"
ANTHROPIC_URL="${ANTHROPIC_DIRECT_BASE_URL:-https://api.anthropic.com}"

usage() {
  cat <<'EOF'
Usage: cmux-trellis-teams [options] [--] [claude arguments...]

Start Claude Code through cmux without giving up panes, teams, hooks, or normal
Claude arguments.

  --mode gptx|codex|hybrid|claude  Provider topology (default: gptx)
  --model sol|terra|luna|MODEL     Main model override
  --advisor auto|opus|fable|sol|none
                                   Advisor override
  --dry-run                        Print the resolved launch contract as JSON
  -h, --help                       Show this help

Examples:
  cmux-trellis-teams --mode gptx --dangerously-skip-permissions
  cmux-trellis-teams --mode codex --dangerously-skip-permissions
  cmux-trellis-teams --mode hybrid --model terra --advisor auto
  cmux-trellis-teams --mode claude --advisor opus
  cmux-trellis-teams --mode claude --advisor sol
EOF
}

die() {
  printf 'cmux-trellis-teams: %s\n' "$*" >&2
  exit 2
}

resolve_cmux() {
  if [[ -n "${CMUX_BIN:-}" ]]; then
    [[ -x "$CMUX_BIN" ]] || die "CMUX_BIN is not executable: $CMUX_BIN"
    printf '%s\n' "$CMUX_BIN"
    return
  fi
  if command -v cmux >/dev/null 2>&1; then
    command -v cmux
    return
  fi
  if [[ -x /Applications/cmux.app/Contents/Resources/bin/cmux ]]; then
    printf '%s\n' /Applications/cmux.app/Contents/Resources/bin/cmux
    return
  fi
  die "cmux was not found; install cmux or set CMUX_BIN"
}

model_id() {
  case "$1" in
    sol) printf '%s\n' gpt-5.6-sol ;;
    terra) printf '%s\n' gpt-5.6-terra ;;
    luna) printf '%s\n' gpt-5.6-luna ;;
    *) printf '%s\n' "$1" ;;
  esac
}

mode=gptx
requested_model=
requested_advisor=
dry_run=false
forwarded=()

while (($#)); do
  case "$1" in
    --mode)
      (($# >= 2)) || die "--mode requires a value"
      mode=$2
      shift 2
      ;;
    --mode=*)
      mode=${1#*=}
      shift
      ;;
    --model)
      (($# >= 2)) || die "--model requires a value"
      requested_model=$2
      shift 2
      ;;
    --model=*)
      requested_model=${1#*=}
      shift
      ;;
    --advisor)
      (($# >= 2)) || die "--advisor requires a value"
      requested_advisor=$2
      shift 2
      ;;
    --advisor=*)
      requested_advisor=${1#*=}
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      forwarded+=("$@")
      break
      ;;
    *)
      forwarded+=("$1")
      shift
      ;;
  esac
done

case "$mode" in
  gptx)
    default_model='opus[1m]'
    default_advisor=auto
    ;;
  codex)
    default_model=terra
    default_advisor=sol
    ;;
  hybrid)
    default_model=terra
    default_advisor=auto
    ;;
  claude)
    default_model='opus[1m]'
    default_advisor=opus
    ;;
  *)
    die "unknown mode '$mode' (expected gptx, codex, hybrid, or claude)"
    ;;
esac

main_model="${requested_model:-$default_model}"
advisor="${requested_advisor:-$default_advisor}"
case "$advisor" in
  auto|opus|fable|sol|none) ;;
  *) die "unknown advisor '$advisor' (expected auto, opus, fable, sol, or none)" ;;
esac

main_is_gpt=false
case "$(model_id "$main_model")" in
  gpt-*|codex-*|o[0-9]*)
    main_is_gpt=true
    ;;
esac

if [[ "$mode" == codex || "$mode" == hybrid ]] && [[ "$main_is_gpt" != true ]]; then
  die "$mode mode requires a GPT/Codex main model"
fi
if [[ "$mode" == claude && "$main_is_gpt" == true ]]; then
  die "claude mode requires a Claude main model"
fi

resolved_model="$(model_id "$main_model")"
base_url=$ROUTER_URL
claude_model=$resolved_model
advisor_transport=server-tool
append_prompt=
context_json=null

env_json="$(
  jq -cn \
    --arg base "$base_url" \
    --arg mode "$mode" \
    --arg advisor "$advisor" \
    '{
      ANTHROPIC_BASE_URL: $base,
      ANTHROPIC_CUSTOM_HEADERS: ("X-Trellis-Mode: " + $mode + "\nX-Trellis-Advisor: " + $advisor)
    }'
)"

if [[ "$main_is_gpt" == true ]]; then
  [[ -x "$CONTEXT_RESOLVER" || -f "$CONTEXT_RESOLVER" ]] || die "missing context resolver: $CONTEXT_RESOLVER"
  context_json="$(node "$CONTEXT_RESOLVER" --model "$resolved_model")"
  context_window="$(jq -er '.claude_code_max_context_tokens' <<<"$context_json")"

  # Claude Code applies advisor eligibility to the selected family before it sends
  # a request. Pinning the official `opus` alias to a gateway model preserves that
  # capability check while the request body still carries the real GPT model ID.
  claude_model=opus
  display_name="$(tr '[:lower:]' '[:upper:]' <<<"${resolved_model#gpt-5.6-}")"
  env_json="$(
    jq -c \
      --arg model "$resolved_model" \
      --arg display "GPT-5.6 $display_name (Trellis)" \
      --arg context "$context_window" \
      '. + {
        ANTHROPIC_DEFAULT_OPUS_MODEL: $model,
        ANTHROPIC_DEFAULT_OPUS_MODEL_NAME: $display,
        ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION: "Codex subscription model through the local Trellis gateway",
        ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES: "effort,xhigh_effort,max_effort,thinking,adaptive_thinking,interleaved_thinking",
        CLAUDE_CODE_MAX_CONTEXT_TOKENS: $context,
        CLAUDE_CODE_ENABLE_EXPERIMENTAL_ADVISOR_TOOL: "1"
      }' <<<"$env_json"
  )"
elif [[ "$mode" == claude && "$advisor" != sol ]]; then
  base_url=$ANTHROPIC_URL
  env_json="$(jq -c --arg base "$base_url" '.ANTHROPIC_BASE_URL = $base | del(.ANTHROPIC_CUSTOM_HEADERS)' <<<"$env_json")"
fi

case "$advisor" in
  none)
    advisor_model=opus
    advisor_transport=disabled
    env_json="$(jq -c '. + {CLAUDE_CODE_DISABLE_ADVISOR_TOOL:"1"}' <<<"$env_json")"
    ;;
  fable)
    advisor_model=claude-fable-5
    ;;
  auto|opus|sol)
    advisor_model=claude-opus-5
    ;;
esac

if [[ "$main_is_gpt" != true && "$advisor" == sol ]]; then
  # A direct Anthropic main request executes Anthropic's server advisor before a
  # local proxy can override it. Use the proven nested-agent path for this one
  # topology and disable the built-in tool so Opus cannot be selected by accident.
  advisor_transport=nested-agent
  env_json="$(jq -c '. + {CLAUDE_CODE_DISABLE_ADVISOR_TOOL:"1"}' <<<"$env_json")"
  append_prompt='Trellis advisor override: use the gpt-sol-advisor Agent exactly once whenever advisor review is required. Treat it as read-only advice. Do not call the built-in advisor tool.'
fi

settings="$(
  jq -cn \
    --arg model "$claude_model" \
    --arg advisorModel "$advisor_model" \
    --argjson env "$env_json" \
    '{model:$model, advisorModel:$advisorModel, env:$env}'
)"

cmux_bin="$(resolve_cmux)"
command=("$cmux_bin" claude-teams --settings "$settings")
if [[ -n "$append_prompt" ]]; then
  command+=(--append-system-prompt "$append_prompt")
fi
if ((${#forwarded[@]})); then
  command+=("${forwarded[@]}")
fi

if [[ "$dry_run" == true ]]; then
  command_json="$(printf '%s\0' "${command[@]}" | jq -Rs 'split("\u0000")[:-1]')"
  jq -n \
    --arg mode "$mode" \
    --arg main_model "$resolved_model" \
    --arg claude_model "$claude_model" \
    --arg advisor "$advisor" \
    --arg advisor_transport "$advisor_transport" \
    --arg base_url "$base_url" \
    --argjson settings "$settings" \
    --argjson context "$context_json" \
    --argjson command "$command_json" \
    '{
      mode:$mode,
      main_model:$main_model,
      claude_model:$claude_model,
      advisor:$advisor,
      advisor_transport:$advisor_transport,
      base_url:$base_url,
      settings:$settings,
      context:$context,
      command:$command
    }'
  exit 0
fi

printf 'Trellis session: mode=%s main=%s advisor=%s (%s)\n' \
  "$mode" "$resolved_model" "$advisor" "$advisor_transport" >&2
exec "${command[@]}"

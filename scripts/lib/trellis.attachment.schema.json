        "removal": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/userRemoval" }
          ]
        },
        "external": { "$ref": "#/$defs/userDetachExternal" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "owner_committed": { "const": true } },
            "required": ["owner_committed"]
          },
          "then": {
            "properties": {
              "external": {
                "properties": { "phase": { "const": 2 } },
                "required": ["phase"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "operation": { "const": "detach" } },
            "required": ["operation"]
          },
          "then": { "properties": { "next_owner": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "operation": { "const": "relink" } },
            "required": ["operation"]
          },
          "then": { "properties": { "next_owner": { "$ref": "#/$defs/userPlan" } } }
        }
      ]
    }
  }
}

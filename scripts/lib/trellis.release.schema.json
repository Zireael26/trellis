{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trellis.local/schemas/trellis.release.schema.json",
  "title": "Trellis immutable release record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "tag", "commit", "remote", "tree"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": { "const": 1 },
    "version": { "$ref": "#/$defs/version" },
    "tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "tree": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/treeEntry" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$"
    },
    "relativeSafePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.(/|$))(?!.*(^|/)\\.\\.(/|$))(?!.*[\\u0000\\t\\n\\r]).*[^/]$"
    },
    "treeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "oid"],
      "properties": {
        "path": { "$ref": "#/$defs/relativeSafePath" },
        "mode": { "enum": ["100644", "100755", "120000"] },
        "oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  }
}
